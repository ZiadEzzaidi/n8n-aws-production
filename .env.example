N8N_VERSION=2.42.6
TIMEZONE=Africa/Casablanca

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# Encrypts the credentials n8n stores (API keys, passwords). Losing it makes them unreadable.
N8N_ENCRYPTION_KEY=change-me

# false only for local http://localhost; true behind HTTPS
N8N_SECURE_COOKIE=false
